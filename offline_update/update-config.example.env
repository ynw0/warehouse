# Copy this file outside the release directory and fill every production path.
APP_ROOT=/mnt/disk0/warehouse-suite
CURRENT_LINK=/mnt/disk0/warehouse-suite/current
RELEASES_DIR=/mnt/disk0/warehouse-suite/releases
DB_PATH=/mnt/disk0/warehouse-suite/data/warehouse.db
BACKUP_DIR=/mnt/disk0/warehouse-suite/backups
REPORT_DIR=/mnt/disk0/warehouse-suite/reports
PYTHON=/usr/bin/python3
SERVICE_NAME=warehouse-suite.service
SERVICE_STOP_COMMAND=systemctl stop warehouse-suite.service
SERVICE_START_COMMAND=systemctl start warehouse-suite.service
# 先参阅包内 MAINTENANCE_GUIDE.md，并改为现场的外部标记文件绝对路径。
MAINTENANCE_ENABLE_COMMAND=/usr/local/sbin/warehouse-maintenance enable --flag /mnt/disk0/warehouse-suite/data/warehouse-maintenance.flag
MAINTENANCE_DISABLE_COMMAND=/usr/local/sbin/warehouse-maintenance disable --flag /mnt/disk0/warehouse-suite/data/warehouse-maintenance.flag
HEALTH_URL=http://127.0.0.1:5000/
ALLOW_TEST_PATHS=0
