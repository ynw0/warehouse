# Copy this file outside the release directory and fill every production path.
APP_ROOT=/srv/warehouse-suite
CURRENT_LINK=/srv/warehouse-suite/current
RELEASES_DIR=/srv/warehouse-suite/releases
DB_PATH=/srv/warehouse-data/warehouse.db
BACKUP_DIR=/srv/warehouse-backups
REPORT_DIR=/srv/warehouse-suite/reports
PYTHON=/usr/bin/python3
SERVICE_NAME=warehouse-suite
SERVICE_STOP_COMMAND=systemctl stop warehouse-suite
SERVICE_START_COMMAND=systemctl start warehouse-suite
# 先参阅包内 MAINTENANCE_GUIDE.md，并改为现场的外部标记文件绝对路径。
MAINTENANCE_ENABLE_COMMAND=/usr/local/sbin/warehouse-maintenance enable --flag /srv/warehouse-data/warehouse-maintenance.flag
MAINTENANCE_DISABLE_COMMAND=/usr/local/sbin/warehouse-maintenance disable --flag /srv/warehouse-data/warehouse-maintenance.flag
HEALTH_URL=http://127.0.0.1:5000/
ALLOW_TEST_PATHS=0
