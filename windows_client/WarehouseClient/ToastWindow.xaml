<Window x:Class="WarehouseClient.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" Height="128"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Background="#172033" CornerRadius="8" Padding="16" BorderBrush="#2a3954" BorderThickness="1" Cursor="Hand">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="TitleText" Foreground="White" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="BodyText" Grid.Row="1" Margin="0,8,0,0" Foreground="#d7e2f1" TextWrapping="Wrap" MaxHeight="58" />
            <TextBlock x:Name="HintText" Grid.Row="2" Margin="0,8,0,0" Foreground="#8fb4e8" FontSize="12" Text="点击查看并关闭" HorizontalAlignment="Right" />
        </Grid>
    </Border>
</Window>
