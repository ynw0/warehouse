<Window x:Class="WarehouseClient.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="登录仓库物料系统" Width="430" Height="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#f4f6f9">
    <Border Margin="24" Padding="24" Background="White" BorderBrush="#d9e0ea" BorderThickness="1" CornerRadius="8">
        <StackPanel>
            <TextBlock Text="仓库物料系统" FontSize="24" FontWeight="SemiBold" Foreground="#0d2f63" />
            <TextBlock x:Name="ServerText" Margin="0,6,0,18" Foreground="#647086" TextTrimming="CharacterEllipsis" />

            <TextBlock Text="账号" Foreground="#647086" Margin="0,0,0,6" />
            <TextBox x:Name="UsernameBox" Height="38" Padding="8,7" Margin="0,0,0,12" />

            <TextBlock Text="密码" Foreground="#647086" Margin="0,0,0,6" />
            <PasswordBox x:Name="PasswordBox" Height="38" Padding="8,7" Margin="0,0,0,12" KeyDown="PasswordBox_KeyDown" />

            <CheckBox x:Name="SavePasswordBox" Content="保存密码（仅当前 Windows 用户可解密）" Margin="0,0,0,10" Checked="SavePasswordBox_Changed" Unchecked="SavePasswordBox_Changed" />
            <CheckBox x:Name="AutoLoginBox" Content="下次自动登录" Margin="0,0,0,16" />

            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ErrorText" VerticalAlignment="Center" Foreground="#b93535" TextWrapping="Wrap" />
                <Button Grid.Column="1" Content="修改服务器" MinWidth="96" Height="38" Margin="0,0,8,0" Click="ChangeServerButton_Click" />
                <Button x:Name="LoginButton" Grid.Column="2" Content="确定" MinWidth="92" Height="38" Click="LoginButton_Click" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
