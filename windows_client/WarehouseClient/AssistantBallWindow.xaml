<Window x:Class="WarehouseClient.AssistantBallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="物料小助手" Width="70" Height="75" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False">
    <Grid x:Name="BallRoot" Background="Transparent" Cursor="Hand">
        <Image x:Name="PreviousImage" Stretch="Uniform" Opacity="0" IsHitTestVisible="False"/>
        <Image x:Name="StateImage" Stretch="Uniform" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform><ScaleTransform x:Name="StateScale"/></Image.RenderTransform>
        </Image>
        <Border x:Name="NoticeBadge" HorizontalAlignment="Right" VerticalAlignment="Top"
                Background="#D83D4B" CornerRadius="9" MinWidth="18" Height="18"
                Padding="3,0" Visibility="Collapsed">
            <TextBlock x:Name="BadgeText" Foreground="White" FontSize="11" FontWeight="Bold"
                       TextAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>
