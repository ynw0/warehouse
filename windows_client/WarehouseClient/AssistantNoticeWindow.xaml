<Window x:Class="WarehouseClient.AssistantNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="310" Height="144" WindowStyle="None" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        AllowsTransparency="True" Background="Transparent">
    <Border Background="#FFFDFEFF" CornerRadius="14" Padding="14"
            BorderBrush="#CFDFEE" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText" Foreground="#245C9E" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1" Content="×" Width="25" Height="25" Click="CloseButton_Click" ToolTip="关闭提醒"/>
            <TextBlock x:Name="BodyText" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,7,0,0" Foreground="#253C56" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
            <Button x:Name="OpenButton" Grid.Row="2" Grid.ColumnSpan="2" Content="查看" HorizontalAlignment="Right" Padding="12,4" Click="OpenButton_Click" />
        </Grid>
    </Border>
</Window>
